    specl:verifiedBy spec:test-a6268b26 .

spec:R9.1 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The registry SHOULD carry graph-level operational metadata per layer graph…" ;
    dct:description "The registry SHOULD carry graph-level operational metadata per layer graph: triple count, last-modified timestamp, and materialized class inventory. `HolonicDataset.refresh_metadata()`, `refresh_all_metadata()`, and `get_graph_metadata()` provide the read/write surface. Shipped with `metadata_updates=\"eager\"|\"off\"` policy." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "357"^^xsd:integer ;
    specl:priority "SHOULD" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-HolonicDataset ;
    specl:constrains spec:component-MetadataRefresher ;
    specl:constrains spec:component-5a8380d6 ;
    specl:acceptanceCriterion "Given a holon with one interior graph, when add_interior runs in eager mode, then get_graph_metadata returns a GraphMetadata with triple_count equal to the parsed count and last_modified within the last second." ;
    specl:verifiedBy spec:test-f8487fa8 .

spec:R9.2 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The CGA ontology MUST declare graph-level metadata vocabulary…" ;
    dct:description "The CGA ontology MUST declare graph-level metadata vocabulary (`cga:ClassInstanceCount` class; `cga:tripleCount`, `cga:lastModified`, `cga:refreshedAt`, `cga:inGraph`, `cga:class`, `cga:count`, `cga:holonLastModified` properties)." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "364"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:verifiedBy spec:test-8c528e68 ;
    specl:constrains spec:component-61e2b393 ;
    specl:acceptanceCriterion "Given cga.ttl, when SPARQL queries the listed IRIs, then all are declared with appropriate rdfs:domain and rdfs:range." .

spec:R9.3 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The CGA ontology MUST declare graph-category vocabulary so named graphs carry…" ;
    dct:description "The CGA ontology MUST declare graph-category vocabulary so named graphs carry RDF types discoverable via SPARQL. Implemented as the flat+role pattern: `cga:HolonicGraph` class plus `cga:graphRole` object property ranged over `cga:LayerRole` individuals. New individual `cga:RegistryRole` covers the cross-cutting registry graph. See `docs/DECISIONS.md` § D-0.3.4-1." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "373"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-1c7dcf37 ;
    specl:acceptanceCriterion "Given add_interior(\"urn:h\"), when the registry is queried, then the interior graph is declared as cga:HolonicGraph with cga:graphRole cga:InteriorRole." ;
    specl:verifiedBy spec:test-1b637595 .

spec:R9.4 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The library MUST add a `resolve(predicate, from_holon, max_depth, order…" ;
    dct:description "The library MUST add a `resolve(predicate, from_holon, max_depth, order, limit)` method implementing decreasing-priority scope resolution across the holarchy. `HolonicDataset.resolve()` in `holonic.scope`. Two predicate classes shipped: `HasClassInInterior` (uses 0.3.3 class inventory) and `CustomSPARQL` (escape hatch). Three ordering modes: `\"network\"` (default, outbound+inbound portals), `\"reverse-network\"`, `\"containment\"`. Strict BFS topology." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "380"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-334465bd ;
    specl:constrains spec:component-72bfb99a ;
    specl:acceptanceCriterion "Given a linear chain of four holons with a target class in the last holon, when resolve(HasClassInInterior(cls), from_holon=first, max_depth=3) is called, then the last holon is returned with distance=3." ;
    specl:verifiedBy spec:test-099e70b9 .

spec:R9.5 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The library MUST ship a migration CLI to backfill graph-type declarations for…" ;
    dct:description "The library MUST ship a migration CLI to backfill graph-type declarations for pre-0.3.4 deployments. `holonic-migrate-registry` entry point, idempotent, dry-run by default." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "387"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-abc763e4 ;
    specl:acceptanceCriterion "Given a pre-0.3.4 registry without cga:HolonicGraph type declarations, when `holonic-migrate-registry --apply` is run, then every layer graph gains its type; a second invocation is a no-op." ;
    specl:verifiedBy spec:test-08317e0c .

spec:R9.6 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The library MUST ship a projection plugin system" ;
    dct:description "The library MUST ship a projection plugin system. Projection pipelines are RDF-modeled specs (`cga:ProjectionPipelineSpec`) in the registry graph, carrying an `rdf:List` of `cga:ProjectionPipelineStep` entries. Python transforms are discovered via the `holonic.projections` entry-point group (both first-party and third-party). Pipelines reference transforms by registered name; registration validates name resolution." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "396"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-ef4c2b0e ;
    specl:constrains spec:component-78096728 ;
    specl:constrains spec:component-142cd3a3 ;
    specl:acceptanceCriterion "Given a ProjectionPipelineSpec with one step referencing transform \"strip_blank_nodes\", when register_pipeline(spec) is called, then the spec is written to the registry as cga:ProjectionPipelineSpec and the transform is resolved via the entry-point registry." ;
    specl:verifiedBy spec:test-9085bed7 .

spec:R9.7 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The library MUST ship `HolonicDataset.register_pipeline()`…" ;
    dct:description "The library MUST ship `HolonicDataset.register_pipeline()`, `attach_pipeline()`, `list_pipelines()`, `get_pipeline()`, and `run_projection()`. Running a pipeline emits a `prov:Activity` in the target holon's context graph with loose version tracking (`cga:transformVersion`) and host metadata (`cga:runHost`, `cga:runPlatform`, `cga:runPythonVersion`, `cga:runHolonicVersion`). Running with `store_as` refreshes metadata on the output graph per D-0.3.3-5." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "403"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-HolonicDataset ;
    specl:constrains spec:component-1d833c38 ;
    specl:acceptanceCriterion "Given a registered pipeline attached to a holon, when run_projection(holon, spec, store_as=out) is called, then a prov:Activity appears in the holon's context graph with all four cga:run* host metadata predicates populated." ;
    specl:verifiedBy spec:test-92185c6d .

spec:R9.8 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The backend protocol MUST split into a mandatory core and an optional mixin" ;
    dct:description "The backend protocol MUST split into a mandatory core and an optional mixin. Implemented as `HolonicStore` (Protocol, mandatory) + `AbstractHolonicStore` (ABC, recommended base with hook points for optional methods). Backends declaring only the Protocol surface continue to work via the library's Python-fallback helpers. Optional native methods are dispatched via `hasattr`. The initial optional surface is a single method: `refresh_graph_metadata(graph_iri, registry_iri)`." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "412"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-7d00f81c ;
    specl:constrains spec:component-MetadataRefresher ;
    specl:acceptanceCriterion "Given a store with a refresh_graph_metadata method, when MetadataRefresher.refresh_graph runs, then the native method is invoked; given a store without it, the Python fallback runs instead." ;
    specl:verifiedBy spec:test-ef4a83b9 .

spec:R9.9 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The library MUST preserve `GraphBackend` as a deprecated alias through the…" ;
    dct:description "The library MUST preserve `GraphBackend` as a deprecated alias through the 0.4.x series and provide a migration guide (`docs/MIGRATION.md`). Deprecation warnings are suppressible via `HOLONIC_SILENCE_DEPRECATION=1`. Superseded by R9.18 in 0.5.0: the alias was removed as planned." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "419"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-eef96aaf ;
    specl:constrains spec:component-b0295dfa ;
    specl:constrains spec:component-3c8d3594 ;
    specl:acceptanceCriterion "Given holonic 0.5.0, when code imports GraphBackend, then an AttributeError is raised (alias removed per R9.18)." ;
    specl:verifiedBy spec:test-9f9d1943 .

spec:R9.10 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The `HolonicDataset` constructor parameter previously named `registry_graph`…" ;
    dct:description "The `HolonicDataset` constructor parameter previously named `registry_graph` MUST be renamed to `registry_iri` for consistency with internal usage. The old name was a deprecated alias through 0.4.x and was removed in 0.5.0 per R9.18." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "426"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-eaf52afc ;
    specl:acceptanceCriterion "Given holonic 0.5.0, when code passes registry_graph= to HolonicDataset, then a TypeError is raised (kwarg removed per R9.18). registry_iri= is the canonical parameter." ;
    specl:verifiedBy spec:test-e5b7a9a4 .

spec:R9.11 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The library SHOULD ship a `holonic.generators` module formalizing the existing…" ;
    dct:description "The library SHOULD ship a `holonic.generators` module formalizing the existing `examples/` holarchy generators (company, research lab, random)." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "435"^^xsd:integer ;
    specl:priority "SHOULD" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-f4ee1e35 ;
    specl:acceptanceCriterion "Given `from holonic.generators import company_holarchy`, when the generator is invoked with a seed, then a deterministic holarchy with documented structure is produced against any HolonicStore." ;
    specl:verifiedBy spec:test-097d2af5 .

spec:R9.12 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The library SHOULD offer a `metadata_updates=\"lazy\"` mode (dirty tracking with…" ;
    dct:description "The library SHOULD offer a `metadata_updates=\"lazy\"` mode (dirty tracking with `flush_metadata()`) if evidence emerges that eager and off modes leave a practical gap." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "442"^^xsd:integer ;
    specl:priority "SHOULD" ;
    specl:implementationStatus "in-progress" ;
    specl:constrains spec:component-HolonicDataset ;
