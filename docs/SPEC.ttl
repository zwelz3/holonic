    specl:acceptanceCriterion "Given a source holon with CCO-shaped data and a target holon with Schema.org boundary shapes, when I register a CONSTRUCT portal and call traverse(source, target, validate=True), then Schema.org triples appear in the target only if validation passes." .

spec:US3 a specl:UserStory ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "As an operator-tool builder, I use `list_holons_summary()`…" ;
