spec:US1 a specl:UserStory ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "As a knowledge engineer, I create a holon, add interior data from multiple…" ;
    dct:description "As a knowledge engineer, I create a holon, add interior data from multiple sources into named sub-graphs, declare boundary shapes, and validate the membrane — all from a single `HolonicDataset` instance against in-memory rdflib." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "685"^^xsd:integer ;
    specl:role spec:P1 ;
    specl:benefit "I can enforce structural contracts on holon interior data without standing up external infrastructure" ;
    specl:acceptanceCriterion "Given HolonicDataset() with an in-memory backend, when I create a holon with two interiors and a boundary shape and call validate_membrane, then I receive a MembraneResult with health and violation details." .

spec:US2 a specl:UserStory ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "As a systems integrator, I register a portal between two holons with a…" ;
