    specl:acceptanceCriterion "Given traversals A->B->C, when `derivation_chain(\"C\")` is called, then `[\"B\", \"A\"]` is returned. When `last_traversal(\"C\")` is called, then a `TraversalRecord` with `target_iri=\"C\"` is returned." ;
    specl:verifiedBy spec:test-8a8ae2bb .

spec:R9.33 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "`compose(holon_iris)` MUST union interior graphs across multiple holons into a…" ;
    dct:description "`compose(holon_iris)` MUST union interior graphs across multiple holons into a single `rdflib.Graph`. Accepts optional `layers` parameter for specifying which layer types to include." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
