    specl:constrains spec:component-3ee12192 ;
    specl:acceptanceCriterion "Given a clean virtualenv, when `pip install holonic` is run, then the package installs from PyPI and `python -c \"import holonic\"` succeeds." ;
    specl:verifiedBy spec:test-31839a9a .

spec:R8.5 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "Optional extras (`dev`, `docs`, `entailment`, `fuseki`, `lint`, `notebooks`…" ;
    dct:description "Optional extras (`dev`, `docs`, `entailment`, `fuseki`, `lint`, `notebooks`, `test`, `viz`) MUST keep the base install under five seconds on a typical network." ;
