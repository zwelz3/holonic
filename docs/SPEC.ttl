    specl:verifiedBy spec:test-d0876aca .

spec:R8.1 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The default pytest suite MUST pass against `RdflibBackend` with no external…" ;
