    specl:verifiedBy spec:test-8f91fbfc .

spec:R8.4 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The package MUST publish to PyPI under `holonic` and be installable with `pip…" ;
    dct:description "The package MUST publish to PyPI under `holonic` and be installable with `pip install holonic`." ;
