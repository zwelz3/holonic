    specl:constrains spec:component-AbstractHolonicStore ;
    specl:acceptanceCriterion "Given a backend implementing an optional method like `walk_neighbors_native`, when the corresponding library helper dispatches, then `hasattr`-based detection invokes the native method without regressing duck-typed backends." ;
    specl:verifiedBy spec:test-7d9c5ba1 .

spec:R9.18 a specl:Requirement ;
