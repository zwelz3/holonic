spec:R7.1 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "Projection operations MUST support two modes: CONSTRUCT (result stays as RDF…" ;
    dct:description "Projection operations MUST support two modes: CONSTRUCT (result stays as RDF, storable in the holarchy) and Pythonic (result exits RDF into LPG-shaped dicts for visualization consumers)." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "281"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-48830ea3 ;
    specl:acceptanceCriterion "Given a source graph, when build_construct() returns a CONSTRUCT string AND project_to_lpg() returns a ProjectedGraph dict, then both modes are available and produce the documented shapes." ;
    specl:verifiedBy spec:test-a6a65b4c .

spec:R7.2 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "`project_to_lpg(graph, ...)` MUST support four independent boolean flags…" ;
    dct:description "`project_to_lpg(graph, ...)` MUST support four independent boolean flags controlling the core simplifications: `collapse_types`, `collapse_literals`, `resolve_blanks`, and `resolve_lists`. Each flag governs a distinct transformation (types→node annotations, literals→node attributes, blank nodes inlined as nested attributes, RDF lists resolved to Python lists) and each MUST be toggleable independently of the others." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "288"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-project_to_lpg ;
    specl:acceptanceCriterion "Given a graph with all four RDF features, when project_to_lpg is called with each flag independently toggled, then each feature is transformed only when its corresponding flag is true." ;
    specl:verifiedBy spec:test-2499bda4 .

spec:R7.3 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "`ProjectionPipeline` MUST compose named steps as a sequence of CONSTRUCT…" ;
    dct:description "`ProjectionPipeline` MUST compose named steps as a sequence of CONSTRUCT queries and Python transforms, with `.apply_to_lpg()` and `.apply_to_graph()` terminal methods." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "295"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-ProjectionPipeline ;
    specl:acceptanceCriterion "Given a pipeline of two CONSTRUCT steps and one transform, when apply_to_graph() is called, then steps run in the declared order and the result reflects all three transformations." ;
    specl:verifiedBy spec:test-fb95d12f .

spec:R7.4 a specl:Requirement ;
