@prefix specl: <https://w3id.org/specl/ns#> .
@prefix spec: <https://zwelz3.github.io/holonic/spec.ttl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://zwelz3.github.io/holonic/spec.ttl> a specl:Specification ;
    dct:conformsTo <https://w3id.org/specl/contract/2> ;
    dct:title "Holonic Library — Graph-Native Holonic RDF Systems" ;
    dct:hasVersion "0.9.0" ;
    specl:status "prototype" ;
    dct:identifier "holonic-001" ;
    dct:created "2026-08-12"^^xsd:date ;
    specl:intent """Provide a Python library that implements Cagel's four-graph holon model on top of RDF named graphs, enabling distributed knowledge systems to expose genuine inside/outside distinction, governed traversal, and event-level provenance without inventing new query languages or wire protocols. The library is a client-side coordination layer in front of any quad-aware graph store (rdflib, Apache Jena Fuseki, Oxigraph, GraphDB) — not a graph database itself.""" ;
    specl:purpose """Make it practical to build holarchies for digital engineering, enterprise knowledge graphs, and agentic memory systems. A holon is a named IRI whose four layers (interior, boundary, projection, context) live as named graphs in the quad store; portals are RDF entities carrying SPARQL CONSTRUCT queries; membranes are SHACL shapes. All state lives in the graph. Python is a thin convenience layer over SPARQL and PROV-O.""" .

spec:source-dcc526b3 a specl:SourceDocument ;
    dct:identifier "SPEC.md" .

spec:R1.1 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "Each holon MUST have an IRI that threads through four named-graph layers…" ;
    dct:description "Each holon MUST have an IRI that threads through four named-graph layers: interior, boundary, projection, and context." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "48"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-HolonicDataset ;
    specl:governs "cga:Holon" ;
    specl:acceptanceCriterion "Given a fresh HolonicDataset, when add_holon(iri, label) is called, then the holon's IRI is registered as cga:Holon and its four layer graphs resolve via cga:hasInterior, cga:hasBoundary, cga:hasProjection, and cga:hasContext." ;
    specl:verifiedBy spec:test-a4a2b808 .

spec:R1.2 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "A holon MAY have multiple named graphs in any one layer role (e.g" ;
    dct:description "A holon MAY have multiple named graphs in any one layer role (e.g. `urn:holon:x/interior/radar` and `urn:holon:x/interior/fusion`); operations that read a layer MUST treat the set as a union." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "56"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-HolonicDataset ;
    specl:governs "cga:LayerRole" ;
    specl:acceptanceCriterion "Given a holon with two interior graphs added with different graph_iri values, when a SPARQL union query ranges over GRAPH ?g patterns, then triples from both graphs match." ;
    specl:verifiedBy spec:test-c52f9b7a .

spec:R1.3 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "Layer membership MUST be declared via `cga:hasInterior`, `cga:hasBoundary`…" ;
    dct:description "Layer membership MUST be declared via `cga:hasInterior`, `cga:hasBoundary`, `cga:hasProjection`, `cga:hasContext`. Layer graph IRIs MUST be discoverable by SPARQL from the holon IRI; discovery by IRI suffix convention is forbidden as a correctness mechanism." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "64"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-HolonicDataset ;
    specl:constrains spec:component-5a8380d6 ;
    specl:acceptanceCriterion "Given a holon with all four layers populated, when the registry is queried with SPARQL following cga:hasInterior et al., then every layer graph IRI is returned without relying on string patterns." ;
    specl:verifiedBy spec:test-43fa1568 .

spec:R1.4 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The library MUST NOT flatten named graphs to a single default graph at any…" ;
    dct:description "The library MUST NOT flatten named graphs to a single default graph at any layer in the stack. Every triple belongs to a named graph." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "71"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:verifiedBy spec:test-787f8b25 ;
    specl:constrains spec:component-HolonicDataset ;
    specl:constrains spec:component-HolonicStore ;
    specl:acceptanceCriterion "Given any library-mediated write, when inspecting the backend's default graph, then no triples produced by the library appear there." .

spec:R2.1 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "A `HolonicStore` protocol MUST provide quad-aware named-graph CRUD…" ;
    dct:description "A `HolonicStore` protocol MUST provide quad-aware named-graph CRUD (`graph_exists`, `get_graph`, `put_graph`, `post_graph`, `delete_graph`, `parse_into`, `list_named_graphs`) and SPARQL dispatch (`query`, `construct`, `ask`, `update`)." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "80"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-HolonicStore ;
    specl:constrains spec:component-RdflibBackend ;
    specl:constrains spec:component-FusekiBackend ;
    specl:acceptanceCriterion "Given an RdflibBackend instance, when isinstance checked against HolonicStore, then the check passes; every listed method exists and accepts the declared signature." ;
    specl:verifiedBy spec:test-3b9c95c5 .

spec:R2.2 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "An in-memory backend (`RdflibBackend`) MUST be shipped so the library is usable…" ;
    dct:description "An in-memory backend (`RdflibBackend`) MUST be shipped so the library is usable with no running server." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "87"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-RdflibBackend ;
    specl:acceptanceCriterion "Given only the base `pip install holonic`, when HolonicDataset() is called without arguments, then a working instance is returned with RdflibBackend bound as the default." ;
    specl:verifiedBy spec:test-7fdc13e1 .

spec:R2.3 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "An HTTP backend (`FusekiBackend`) MUST be shipped for Apache Jena Fuseki via…" ;
    dct:description "An HTTP backend (`FusekiBackend`) MUST be shipped for Apache Jena Fuseki via SPARQL 1.1 and the W3C Graph Store Protocol." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "94"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-FusekiBackend ;
    specl:acceptanceCriterion "Given a running Fuseki server, when FusekiBackend(url, dataset=ds) is instantiated and used with HolonicDataset, then CRUD and SPARQL operations round-trip through HTTP against the server." ;
    specl:verifiedBy spec:test-902deafa .

spec:R2.4 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "`FusekiBackend` MUST accept `extra_headers` at construction so external…" ;
    dct:description "`FusekiBackend` MUST accept `extra_headers` at construction so external orchestrators can pass bearer tokens, mTLS hints, or tenant identifiers through to Fuseki." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "101"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-FusekiBackend ;
    specl:constrains spec:component-_fuseki_client ;
    specl:acceptanceCriterion "Given FusekiBackend(url, dataset=ds, extra_headers={\"Authorization\": \"Bearer x\"}), when any HTTP request is issued, then the header is present on the outbound request." ;
    specl:verifiedBy spec:test-ccc942ee .

spec:R2.5 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The protocol MUST remain synchronous" ;
    dct:description "The protocol MUST remain synchronous. Async consumers wrap calls in their own thread-pool bridge; an async variant, if added, MUST be a separate protocol and not replace the sync one." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "108"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-HolonicStore ;
    specl:acceptanceCriterion "Given the HolonicStore protocol definition, when method signatures are inspected, then none are declared with async def and no awaitables are returned." ;
    specl:verifiedBy spec:test-67f652bd .

spec:R2.6 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "Backend method return types MUST use `rdflib.Graph` for CONSTRUCT and…" ;
    dct:description "Backend method return types MUST use `rdflib.Graph` for CONSTRUCT and graph-fetch operations to preserve rdflib's serialization, iteration, and SPARQL evaluation surface." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "115"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-HolonicStore ;
    specl:constrains spec:component-RdflibBackend ;
    specl:constrains spec:component-FusekiBackend ;
    specl:acceptanceCriterion "Given store.get_graph() or store.construct() is called, when the return value is inspected, then it is an rdflib.Graph instance supporting serialize(), iteration, and further SPARQL queries." ;
    specl:verifiedBy spec:test-38d67d85 .

spec:R3.1 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The package MUST ship the Context-Graph Architecture (CGA) ontology (`cga.ttl`)…" ;
    dct:description "The package MUST ship the Context-Graph Architecture (CGA) ontology (`cga.ttl`) and SHACL shapes (`cga-shapes.ttl`) as package data." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "124"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-5a8380d6 ;
    specl:constrains spec:component-b3d4462b ;
    specl:constrains spec:component-566ad6b5 ;
    specl:acceptanceCriterion "Given `pip install holonic`, when the package is introspected, then both TTL files are present as resources under holonic.ontology and parse cleanly with rdflib." ;
    specl:verifiedBy spec:test-d605e4c6 .

spec:R3.2 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The ontology MUST define `cga:Holon` and its functional subclasses…" ;
    dct:description "The ontology MUST define `cga:Holon` and its functional subclasses (`cga:DataHolon`, `cga:AlignmentHolon`, `cga:AgentHolon`, `cga:GovernanceHolon`, `cga:AggregateHolon`, `cga:IndexHolon`), `cga:Portal` and its subclasses (`cga:TransformPortal`, `cga:IconPortal`, `cga:SealedPortal`), `cga:LayerGraph`, and `cga:LayerRole`. Portal subtype semantics MUST be enforced by SHACL shapes in `cga-shapes.ttl`: `cga:TransformPortal` requires exactly one `cga:constructQuery`; `cga:IconPortal` and `cga:SealedPortal` must not carry `cga:constructQuery` (carrying one is semantically incoherent because an IconPortal is purely referential and a SealedPortal blocks traversal)." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "131"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-5a8380d6 ;
    specl:acceptanceCriterion "Given cga.ttl, when SPARQL queries every declared class, then all listed class IRIs are returned with their subclass relationships intact." ;
    specl:verifiedBy spec:test-8b6852e1 .

spec:R3.3 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The ontology MUST use RDFS plus minimal OWL (class hierarchy, domain/range)" ;
    dct:description "The ontology MUST use RDFS plus minimal OWL (class hierarchy, domain/range). The library MUST NOT depend on an OWL reasoner for correctness of any method." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "138"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-5a8380d6 ;
    specl:constrains spec:component-HolonicDataset ;
    specl:acceptanceCriterion "Given an rdflib-backed HolonicDataset, when the entailment extra is not installed, then every library method produces correct results without a reasoner." ;
    specl:verifiedBy spec:test-704eac00 .

spec:R3.4 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "`validate_membrane(holon_iri)` MUST run pyshacl against the union of the…" ;
    dct:description "`validate_membrane(holon_iri)` MUST run pyshacl against the union of the holon's interior graphs using the union of its boundary graphs and MUST return a `MembraneResult` with one of `Intact` / `Weakened` / `Compromised`." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "145"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-7d653801 ;
    specl:constrains spec:component-MembraneResult ;
    specl:acceptanceCriterion "Given a holon whose interior violates a boundary shape, when validate_membrane is called, then result.health is MembraneHealth.Compromised and result.violations lists the specific SHACL failures." ;
    specl:verifiedBy spec:test-3ec36cea .

spec:R3.5 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "Membrane health MUST be recordable in the context graph as `cga:membraneHealth`…" ;
    dct:description "Membrane health MUST be recordable in the context graph as `cga:membraneHealth` on a `prov:Activity`." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "152"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-a5927d86 ;
    specl:constrains spec:component-5a8380d6 ;
    specl:acceptanceCriterion "Given a governed traversal with validate=True, when the activity is read from the context graph, then cga:membraneHealth is present and matches the MembraneResult.health value." ;
    specl:verifiedBy spec:test-8a5bd88b .

spec:R4.1 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "Portals MUST be first-class RDF entities stored in boundary graphs with…" ;
    dct:description "Portals MUST be first-class RDF entities stored in boundary graphs with `cga:sourceHolon`, `cga:targetHolon`, and (for `cga:TransformPortal`) `cga:constructQuery`." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "161"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-b0376446 ;
    specl:governs "cga:Portal" ;
    specl:governs "cga:TransformPortal" ;
    specl:acceptanceCriterion "Given add_portal(iri, source, target, construct_query, label), when the registry is queried, then the portal is found with cga:sourceHolon, cga:targetHolon, and cga:constructQuery as RDF triples." ;
    specl:verifiedBy spec:test-d3fc2aef .

spec:R4.2 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "Portal discovery MUST be SPARQL-driven (`find_portals_from`, `find_portals_to`…" ;
    dct:description "Portal discovery MUST be SPARQL-driven (`find_portals_from`, `find_portals_to`, `find_portal`, `find_path`). Python-side iteration over cached portal objects is forbidden." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "169"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-cfbc4336 ;
    specl:constrains spec:component-ac2f441a ;
    specl:acceptanceCriterion "Given portals in the registry, when find_portals_from(iri) is called, then results come from a SPARQL SELECT executed against the store, not from a Python cache." ;
    specl:verifiedBy spec:test-f2e2d11f .

spec:R4.3 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "`traverse_portal(portal_iri)` MUST execute the portal's CONSTRUCT query against…" ;
    dct:description "`traverse_portal(portal_iri)` MUST execute the portal's CONSTRUCT query against the quad store and MAY inject the result into a target named graph." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "176"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-da09c161 ;
    specl:acceptanceCriterion "Given a registered portal and inject_into=target_graph, when traverse_portal is called, then the CONSTRUCT's triples appear in the target graph and the CONSTRUCT result Graph is returned." ;
    specl:verifiedBy spec:test-7d269901 .

spec:R4.4 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "`traverse(source, target, validate=True)` MUST compose discovery, traversal…" ;
    dct:description "`traverse(source, target, validate=True)` MUST compose discovery, traversal, membrane validation, and provenance recording as one governed operation. Validation failure MUST NOT inject data into the target interior." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "183"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-16396f5e ;
    specl:acceptanceCriterion "Given a boundary shape that rejects the source data, when traverse(source, target, validate=True) is called, then the target interior contains no new triples and the returned membrane result is Compromised." ;
    specl:verifiedBy spec:test-3f8a6f6c .

spec:R4.5 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "Multi-hop path finding (`find_path`) MUST discover a portal route from source…" ;
    dct:description "Multi-hop path finding (`find_path`) MUST discover a portal route from source to target. The current implementation fetches the portal adjacency list via `Q.ALL_PORTALS` and runs Python BFS. Deferred to 0.8.0: migrate to a SPARQL property-path query or cache the adjacency list across calls." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "190"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "in-progress" ;
    specl:constrains spec:component-4e7174b7 ;
    specl:constrains spec:component-b955441d ;
    specl:acceptanceCriterion "Given a chain of three holons linked by portals, when find_path(source, target) is called, then a list of PortalInfo objects representing the path is returned." ;
    specl:verifiedBy spec:test-9df2df26 .

spec:R5.1 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "Every governed traversal and membrane validation MUST emit a `prov:Activity`…" ;
    dct:description "Every governed traversal and membrane validation MUST emit a `prov:Activity` into the target holon's context graph, including `prov:wasAssociatedWith`, `prov:used`, `prov:generated`, and `prov:startedAtTime`." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "199"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-16396f5e ;
    specl:constrains spec:component-719634f9 ;
    specl:constrains spec:component-a5927d86 ;
    specl:acceptanceCriterion "Given traverse(source, target, agent_iri=\"urn:agent:x\"), when the context graph is queried, then a prov:Activity exists with all four listed predicates populated." ;
    specl:verifiedBy spec:test-f642b4cb .

spec:R5.2 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "Graph-to-graph derivation produced by a traversal (target interior derived from…" ;
    dct:description "Graph-to-graph derivation produced by a traversal (target interior derived from source interior) MUST use `prov:wasDerivedFrom` and MUST be distinct from `cga:derivedFrom`." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "206"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:verifiedBy spec:test-0b1eb1fe ;
    specl:constrains spec:component-16396f5e ;
    specl:constrains spec:component-5a8380d6 ;
    specl:acceptanceCriterion "Given a completed traversal, when the context graph is queried, then the target interior carries prov:wasDerivedFrom pointing to the source interior AND no cga:derivedFrom triple was created as a side effect." .

spec:R5.3 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "`cga:derivedFrom` MUST be reserved for persistent holon-to-holon structural…" ;
    dct:description "`cga:derivedFrom` MUST be reserved for persistent holon-to-holon structural dependency independent of any activity. The two properties coexist; neither replaces the other." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "213"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:verifiedBy spec:test-e68d6e25 ;
    specl:verifiedBy spec:test-c3358b2d ;
    specl:constrains spec:component-5a8380d6 ;
    specl:acceptanceCriterion "Given cga.ttl, when SPARQL queries cga:derivedFrom, then it is declared an owl:ObjectProperty scoped Holon→Holon AND carries no rdfs:subPropertyOf or owl:equivalentProperty axiom relating it to prov:wasDerivedFrom." .

spec:R5.4 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "`HolonSplit` and `HolonMerge` MUST be modeled as `prov:Activity` subclasses…" ;
    dct:description "`HolonSplit` and `HolonMerge` MUST be modeled as `prov:Activity` subclasses with `prov:used` (source holon) and `prov:generated` (resulting holons)." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "221"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:verifiedBy spec:test-984ddc78 ;
    specl:constrains spec:component-5a8380d6 ;
    specl:acceptanceCriterion "Given a HolonSplit instance, when SPARQL queries its rdf:type chain, then prov:Activity appears in the class hierarchy and both prov:used and prov:generated are declared." .

spec:R6.1 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The `holonic.console_model` module MUST expose dataclasses tuned for JSON…" ;
    dct:description "The `holonic.console_model` module MUST expose dataclasses tuned for JSON serialization over HTTP: `HolonSummary`, `HolonDetail`, `ClassInstanceCount`, `NeighborhoodNode`, `NeighborhoodEdge`, `NeighborhoodGraph`, `PortalSummary`, `PortalDetail`." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
    specl:sourceLine "230"^^xsd:integer ;
    specl:priority "MUST" ;
    specl:implementationStatus "verified" ;
    specl:constrains spec:component-04830ab1 ;
    specl:acceptanceCriterion "Given each named dataclass, when round-tripped through dataclasses.asdict + json.dumps + json.loads, then no information is lost and no rdflib types leak." ;
    specl:verifiedBy spec:test-8e61b284 .

spec:R6.2 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "`NeighborhoodGraph.to_graphology()` MUST return a dict matching graphology's…" ;
