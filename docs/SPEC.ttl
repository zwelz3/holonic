    specl:acceptanceCriterion "Given a populated holarchy, when I call list_holons_summary() and holon_neighborhood(iri, depth=2).to_graphology(), then the returned dicts deserialize to JSON suitable for direct sigma.js consumption." .

spec:US4 a specl:UserStory ;
