    specl:verifiedBy spec:test-ac4902cb .

spec:R9.15 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "The library SHOULD ship a migration pass that synthesizes minimal…" ;
    dct:description "The library SHOULD ship a migration pass that synthesizes minimal `cga:ProjectionPipelineSpec` resources for projection graphs registered before 0.3.5, so historical projections get consistent provenance." ;
    prov:wasDerivedFrom spec:source-dcc526b3 ;
