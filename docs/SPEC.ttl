    specl:acceptanceCriterion "Given a pre-0.3.5 registry with projection layer graphs but no pipeline specs, when the migration CLI is run, then a minimal ProjectionPipelineSpec is synthesized for each projection and attached via cga:hasPipeline." ;
    specl:verifiedBy spec:test-097d2af5 .

spec:R9.16 a specl:Requirement ;
    specl:partOf <https://zwelz3.github.io/holonic/spec.ttl> ;
    dct:title "Pipeline steps SHOULD support per-step arguments (e.g" ;
    dct:description "Pipeline steps SHOULD support per-step arguments (e.g. `filter_by_class(class_iri)`) via a `cga:stepArguments` JSON literal or structured argument record." ;
